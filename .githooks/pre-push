#!/bin/sh
# Git supplies one line per pushed ref. Deletions and non-commit tags need no check.
set -eu
root=$(git rev-parse --show-toplevel)
checked=' '
while read -r local_ref local_oid _remote_ref remote_oid; do
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac
    [ "$local_oid" != "$remote_oid" ] || continue
    if ! git rev-parse --verify "$local_oid^{commit}" >/dev/null 2>&1; then
        continue
    fi
    tree=$(git rev-parse --verify "$local_oid^{tree}")
    case "$checked" in *" $tree "*) continue ;; esac
    printf 'nanoui: checking pushed ref %s\n' "$local_ref"
    sh "$root/tools/check-snapshot.sh" "$tree" </dev/null
    checked="$checked$tree "
done
